<?xml version="1.0" ?>
<!--
  TurtleBot3 world — modified for the localization project.

  The only change from the default nav2_bringup world is the "landmark_pillar"
  model at the bottom of this file.  Everything else (walls, regular cylinders,
  ground plane, sun) is identical to the original.

  Landmark specs:
    position : (1.8, 0.0) in the world/map frame
    radius   : 0.05 m   ← thinner than the regular cylinders (0.15 m)
    height   : 0.50 m
    colour   : blue, so it's easy to spot in the Gazebo GUI

  The nav map was recorded without this pillar, which is intentional: the pillar
  is small enough that it doesn't block navigation paths, so the existing map
  still works.  The filters use it purely for landmark-based corrections.
-->
<sdf version="1.6">
  <world name="world">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Plugins needed for Gazebo/ROS 2 integration -->
    <plugin filename="libgazebo_ros_init.so"        name="gazebo_ros_init"/>
    <plugin filename="libgazebo_ros_factory.so"     name="gazebo_ros_factory"/>
    <plugin filename="libgazebo_ros_force_system.so" name="gazebo_ros_force_system"/>

    <!-- Light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- The standard TurtleBot3 world (walls + regular cylinders) -->
    <include>
      <uri>model://turtlebot3_world</uri>
    </include>

    <!-- ─────────────────────────────────────────────────────────────────────
         Landmark pillar
         This is the only addition compared to the default world.
         radius = 0.05 m  →  laser cluster width ≈ 0.10 m  → accepted
         regular cylinders: radius = 0.15 m → cluster ≈ 0.30 m → rejected
         ───────────────────────────────────────────────────────────────────── -->
    <model name="landmark_pillar">
      <static>true</static>
      <pose>1.8 0.0 0.25 0 0 0</pose>   <!-- z=0.25 centres a 0.5 m tall cylinder on the ground -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.2 1.0 1.0</ambient>
            <diffuse>0.0 0.2 1.0 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>