# =============================================================================
# Shared noise parameters for KF, EKF and PF
# Change values here once — all three filters use the same numbers.
# =============================================================================

# Applied to all three nodes (kf_node, ekf_node, pf_node)
/**:
  ros__parameters:

    # -------------------------------------------------------------------------
    # Process noise R (how much we distrust the motion model)
    # Higher = more uncertainty in prediction → filter trusts sensor more
    # -------------------------------------------------------------------------
    r_x:       0.3   # position x
    r_y:       0.3   # position y
    r_theta:   0.3   # heading
    r_vx:      0.3   # velocity x
    r_vy:      0.3   # velocity y
    r_omega:   0.3   # angular velocity

    # -------------------------------------------------------------------------
    # Odometry measurement noise Q_odom (how much we distrust the odom sensor)
    # Higher = less trust in odom → filter relies more on prediction
    # -------------------------------------------------------------------------
    q_odom_x:     0.5
    q_odom_y:     0.5
    q_odom_theta: 0.5

    # -------------------------------------------------------------------------
    # Landmark measurement noise Q_lm
    # -------------------------------------------------------------------------
    q_lm_r:   0.05   # range noise
    q_lm_phi: 0.01   # bearing noise

    # -------------------------------------------------------------------------
    # PF only: threshold factor for resampling
    #   0.0 = pure multinomial (no filtering)
    #   0.5 = drop particles below 50% of average weight
    #   1.5 = aggressive, only well-above-average particles survive
    # -------------------------------------------------------------------------
    pf_threshold_factor: 0.0


    # Effective dt multiplier: skip_n=1 → ~50ms, skip_n=5 → ~250ms
    skip_n: 1